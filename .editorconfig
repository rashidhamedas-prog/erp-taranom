root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,woff,woff2,ttf,eot,ico,pdf,docx,zip,apk}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
