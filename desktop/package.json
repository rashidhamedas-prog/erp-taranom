{
  "name": "erp-taranom-desktop",
  "productName": "ERP Taranom",
  "version": "2.0.9",
  "description": "ERP Taranom - Offline Desktop (Windows) with central-server sync",
  "main": "main.js",
  "author": "Taranom",
  "license": "UNLICENSED",
  "scripts": {
    "prepare-server": "node scripts/prepare-server.js",
    "postinstall": "electron-builder install-app-deps",
    "start": "npm run prepare-server && electron .",
    "dist:win": "npm run prepare-server && electron-builder --win nsis --x64",
    "publish:win": "node ../scripts/publish-desktop.js",
    "dist:linux": "npm run prepare-server && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "11.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "otplib": "^12.0.1",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ir.taranom.crm.desktop",
    "productName": "ERP Taranom",
    "asar": false,
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "files": [
      "main.js",
      "preload.js",
      "security-policy.js",
      "local-secret-store.js",
      "server/**/*",
      "!server/node_modules",
      "!server/crm.db*",
      "!server/*.db*",
      "!server/backups/**",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ERP Taranom",
      "installerLanguages": [
        "en_US"
      ],
      "unicode": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/releases/"
      }
    ]
  }
}
