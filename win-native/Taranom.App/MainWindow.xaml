<Window x:Class="Taranom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERP Taranom (native)"
        Height="640" Width="720"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="TitleText" Text="ERP Taranom" FontSize="26" FontWeight="SemiBold" Foreground="#1A5C38"/>
      <TextBlock x:Name="HostStatus" Margin="0,4,0,0" Foreground="#666" FontSize="12"/>
      <TextBlock x:Name="StatusText" Margin="0,8,0,12" TextWrapping="Wrap" FontSize="13"/>
    </StackPanel>

    <StackPanel x:Name="LoginPanel" DockPanel.Dock="Top" Width="320" HorizontalAlignment="Right">
      <TextBlock Text="ورود محلی" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="UserBox" Text="admin" Margin="0,0,0,8" Padding="6"/>
      <PasswordBox x:Name="PassBox" Margin="0,0,0,8" Padding="6"/>
      <Button Content="ورود" Click="OnLoginClick" Padding="10,6" Background="#1A5C38" Foreground="White"/>
    </StackPanel>

    <Grid x:Name="WorkPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="تازه‌سازی" Click="OnRefreshCustomers" Margin="0,0,8,0" Padding="8,4"/>
          <Button Content="بکاپ محلی" Click="OnBackup" Margin="0,0,8,0" Padding="8,4"/>
          <Button Content="Sync اکنون" Click="OnSyncNow" Padding="8,4"/>
        </StackPanel>
        <ListBox x:Name="CustomerList"/>
      </DockPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="مشتری جدید" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="NewBizBox" Margin="0,0,0,8" Padding="6"/>
        <TextBox x:Name="NewPhoneBox" Margin="0,0,0,8" Padding="6"/>
        <Button Content="ثبت مشتری" Click="OnCreateCustomer" Padding="10,6" Background="#C4A35A"/>
        <TextBlock Text="وضعیت Sync" Margin="0,24,0,8" FontWeight="SemiBold"/>
        <TextBlock x:Name="SyncStatus" TextWrapping="Wrap" FontSize="11" Foreground="#444"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
