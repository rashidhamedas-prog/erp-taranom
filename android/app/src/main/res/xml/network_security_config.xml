<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is required for (a) the embedded local server on
     127.0.0.1 and (b) the central server, which is currently served over
     plain HTTP. Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">45.90.98.99</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
